#!/bin/bash
# omaclippr — passive instant-replay clip buffer for Omarchy.
#
# Wraps gpu-screen-recorder's native replay mode: the buffer lives in RAM
# (-replay-storage ram), never touches the SSD until you save a clip, and
# "saving" is a stream-copy mux from the in-memory ring, so it finishes in
# well under 200 ms with no re-encode.
#
# Commands:
#   omaclippr start  [30|60|120] low|balanced|high
#   omaclippr stop
#   omaclippr clip   [seconds]
#   omaclippr status             -> {"active":true,"duration":60,"quality":"balanced","clips":[...]}
#   omaclippr clips              -> JSON array of recent clips (newest first)
#   omaclippr toggle [seg [qual]]
#
# State/lock: $RUNTIME_DIR/omaclippr/  (RUNTIME_DIR = $XDG_RUNTIME_DIR or /tmp)

set -u

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
STATE_DIR="$RUNTIME_DIR/omaclippr"
mkdir -p "$STATE_DIR" 2>/dev/null

PIDFILE="$STATE_DIR/pid"
CONFFILE="$STATE_DIR/config"
# The unix-domain socket path must stay under ~108 bytes, and $XDG_RUNTIME_DIR
# can be long, so keep the socket short and stable in /tmp.
SOCKFILE="/tmp/omaclippr.gsr.sock"

[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
CLIP_DIR="${OMACLIPPR_CLIP_DIR:-${XDG_VIDEOS_DIR:-$HOME/Videos}/Clips}"

# ---------------------------------------------------------------- quality presets
declare -A QUALITY_FPS QUALITY_CODEC QUALITY_BITRATE QUALITY_DIM
# low:     720p 30fps ~4Mbps
# balanced:1080p 60fps ~9Mbps
# high:    native 60fps ~18Mbps
QUALITY_FPS[low]=30
QUALITY_DIM[low]="1280x720"
QUALITY_BITRATE[low]=4000

QUALITY_FPS[balanced]=60
QUALITY_DIM[balanced]="1920x1080"
QUALITY_BITRATE[balanced]=9000

QUALITY_FPS[high]=60
QUALITY_DIM[high]=""
QUALITY_BITRATE[high]=18000

qual="${2:-balanced}"
[[ -v QUALITY_FPS[$qual] ]] || qual="balanced"

focused_monitor() {
  omarchy-hyprland-monitor-focused 2>/dev/null || echo ""
}

notify() {
  omarchy-notification-send -t 2500 "$1" 2>/dev/null || true
}

gsr_pid() {
  if [[ -f "$PIDFILE" ]]; then
    local p
    p=$(cat "$PIDFILE" 2>/dev/null)
    if [[ -n "${p:-}" ]] && kill -0 "$p" 2>/dev/null; then
      echo "$p"
    fi
  fi
}

clip_exists() {
  [[ -n "${1:-}" && -f "$1" ]]
}

# ---------------------------------------------------------------- save a clip
save_clip() {
  local seconds="${1:-}"
  local pid sock
  pid=$(gsr_pid)
  [[ -n "$pid" ]] || { echo '{"ok":false,"error":"not running"}'; return 1; }
  sock="$SOCKFILE"
  [[ -S "$sock" ]] || { echo '{"ok":false,"error":"no ipc socket"}'; return 1; }

  local path
  if [[ -n "$seconds" ]]; then
    path=$(gsr-cli -ipc "$sock" save-replay "$seconds" 2>/dev/null | tr -d '\r\n')
  else
    path=$(gsr-cli -ipc "$sock" save-replay 2>/dev/null | tr -d '\r\n')
  fi
  path="${path#"${path%%[![:space:]]*}"}"
  path="${path%"${path##*[![:space:]]}"}"

  if clip_exists "$path"; then
    notify "Clip saved: ${path##*/}"
    echo "{\"ok\":true,\"path\":\"$path\"}"
  else
    echo "{\"ok\":false,\"error\":\"save failed\"}"
    return 1
  fi
}

# ---------------------------------------------------------------- devices
# Lists capture sources so the UI can offer screen/mic/system choices.
cmd_devices() {
  local monitors speakers mics
  monitors=$(gpu-screen-recorder --list-monitors 2>/dev/null | jq -Rrn '[inputs | split("|") | select(.[0] != "") | {name:.[0], resolution:(.[1] // "")}]')
  speakers=$(gpu-screen-recorder --list-audio-devices 2>/dev/null | jq -Rrn '[inputs | split("|") | select(.[0] != "") | select(.[0] == "default_output" or (.[0] | test("\\.monitor$"))) | {name:.[0], label:.[1]}]')
  mics=$(gpu-screen-recorder --list-audio-devices 2>/dev/null | jq -Rrn '[inputs | split("|") | select(.[0] != "") | select(.[0] == "default_input" or (.[0] | test("input"))) | {name:.[0], label:.[1]}]')

  jq -n \
    --argjson monitors "$monitors" \
    --argjson speakers "$speakers" \
    --argjson mics "$mics" \
    '{monitors:$monitors, speakers:$speakers, mics:$mics}'
}

# Read persisted prefs, filling defaults for any missing key. Mic and system
# sound default to the system's default input/output rather than off.
load_prefs() {
  payload='{"duration":60,"quality":"balanced","screen":"","mic":"default_input","system":"default_output"}'
  if [[ -f "$CONFFILE" ]]; then
    payload=$(jq -c '
      {
        duration: (.duration // 60),
        quality: (.quality // "balanced"),
        screen: (.screen // ""),
        mic: ((.mic // "default_input") | if . == "" then "default_input" else . end),
        system: ((.system // "default_output") | if . == "" then "default_output" else . end)
      }' "$CONFFILE" 2>/dev/null || echo '{"duration":60,"quality":"balanced","screen":"","mic":"default_input","system":"default_output"}')
  fi
}

# ---------------------------------------------------------------- start
cmd_start() {
  local duration="${1:-60}"
  shift 2>/dev/null || true
  local q="${1:-balanced}"
  [[ -v QUALITY_FPS[$q] ]] || q="balanced"

  local pid
  pid=$(gsr_pid)
  if [[ -n "$pid" ]]; then
    echo '{"ok":true,"already":true}'
    return 0
  fi

  mkdir -p "$CLIP_DIR" 2>/dev/null || {
    notify "Could not create $CLIP_DIR"
    echo '{"ok":false,"error":"clips dir"}'
    return 1
  }

  load_prefs
  local screen mic system
  screen=$(jq -r '.screen // ""' <<<"$payload")
  mic=$(jq -r '.mic // ""' <<<"$payload")
  system=$(jq -r '.system // ""' <<<"$payload")

  # Screen target: explicit monitor, else the focused monitor, else "screen".
  local target="-w screen"
  if [[ -n "$screen" ]]; then
    target="-w $screen"
  else
    local m
    m=$(focused_monitor)
    [[ -n "$m" ]] && target="-w $m"
  fi

  # Audio sources: pipe-separated list of everything selected. A value of
  # "none" (the UI's explicit-off choice) is treated as no source.
  local audio=""
  local parts=()
  [[ -n "$system" && "$system" != "none" ]] && parts+=( "$system" )
  [[ -n "$mic" && "$mic" != "none" ]] && parts+=( "$mic" )
  if (( ${#parts[@]} > 0 )); then
    audio=$(IFS='|'; echo "${parts[*]}")
  fi

  local fps="${QUALITY_FPS[$q]}"
  local bitrate="${QUALITY_BITRATE[$q]}"
  local dim="${QUALITY_DIM[$q]}"

  local args=( $target -f "$fps" -k auto -c mp4 -bm cbr -q "$bitrate" -fm cfr )
  [[ -n "$dim" ]] && args+=( -s "$dim" )
  [[ -n "$audio" ]] && args+=( -a "$audio" -ac aac )

  args+=( -r "$duration" -replay-storage ram -o "$CLIP_DIR" -ipc "$SOCKFILE" )

  setsid gpu-screen-recorder "${args[@]}" >/dev/null 2>&1 &
  pid=$!

  # Wait for the IPC socket to appear so the next clip lands cleanly.
  local n=0
  while ((n < 60)); do
    kill -0 "$pid" 2>/dev/null || break
    [[ -S "$SOCKFILE" ]] && break
    sleep 0.1
    ((n++))
  done

  if kill -0 "$pid" 2>/dev/null; then
    echo "$pid" >"$PIDFILE"
    echo "$payload" >"$CONFFILE"
    notify "Buffer active · ${duration}s · $q"
    echo "{\"ok\":true,\"pid\":$pid,\"duration\":$duration,\"quality\":\"$q\"}"
  else
    rm -f "$PIDFILE" "$SOCKFILE"
    notify "Buffer failed to start"
    echo '{"ok":false,"error":"failed to start"}'
    return 1
  fi
}

# ---------------------------------------------------------------- stop
cmd_stop() {
  local pid
  pid=$(gsr_pid)
  if [[ -z "$pid" ]]; then
    [[ -f "$PIDFILE" ]] && rm -f "$PIDFILE"
    echo '{"ok":true,"already_stopped":true}'
    return 0
  fi
  kill -INT "$pid" 2>/dev/null
  local n=0
  while ((n < 40)); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.05
    ((n++))
  done
  kill -KILL "$pid" 2>/dev/null
  rm -f "$PIDFILE" "$SOCKFILE"
  notify "Buffer stopped"
  echo '{"ok":true}'
}

# ---------------------------------------------------------------- clip
cmd_clip() {
  save_clip "${1:-}"
}

# ---------------------------------------------------------------- delete
cmd_delete() {
  local path="${1:-}"
  # Only ever unlink files inside the clips directory.
  local real realdir
  real=$(realpath -m "$path" 2>/dev/null) || { echo '{"ok":false,"error":"bad path"}'; return 1; }
  realdir=$(realpath -m "$CLIP_DIR" 2>/dev/null)
  case "$real" in
    "$realdir"/*) ;;
    *) echo '{"ok":false,"error":"refusing to delete outside clips dir"}'; return 1 ;;
  esac
  [[ -f "$real" ]] || { echo '{"ok":false,"error":"no such file"}'; return 1; }
  rm -f -- "$real" && echo "{\"ok\":true,\"path\":\"$real\"}" || echo '{"ok":false,"error":"delete failed"}'
}

# ---------------------------------------------------------------- status / clips
# Emits one line per clip: <path><TAB><epoch-seconds>, newest first.
list_clips() {
  [[ -d "$CLIP_DIR" ]] || return 0
  find "$CLIP_DIR" -maxdepth 1 -type f \( -iname '*.mp4' -o -iname '*.mkv' \) -printf '%p\t%T@\n' \
    2>/dev/null | sort -t$'\t' -k2 -rn | head -3
}

cmd_status() {
  local pid active config
  pid=$(gsr_pid)
  active="false"
  [[ -n "$pid" ]] && active="true"

  load_prefs
  local duration q screen mic system
  duration=$(jq -r '.duration' <<<"$payload")
  q=$(jq -r '.quality' <<<"$payload")
  screen=$(jq -r '.screen' <<<"$payload")
  mic=$(jq -r '.mic' <<<"$payload")
  system=$(jq -r '.system' <<<"$payload")

  local clips_json="["
  local first=1
  while IFS=$'\t' read -r path ts; do
    [[ -n "$path" ]] || continue
    [[ $first -eq 0 ]] && clips_json+=","
    local pquoted tquoted
    pquoted=$(jq -Rn --arg v "$path" '$v')
    tquoted=$(printf '%.0f' "$ts" 2>/dev/null || echo 0)
    clips_json+="{\"path\":${pquoted},\"ts\":${tquoted}}"
    first=0
  done < <(list_clips)
  clips_json+="]"

  jq -n \
    --argjson active "$( [[ "$active" == "true" ]] && echo true || echo false )" \
    --arg duration "$duration" \
    --arg quality "$q" \
    --arg screen "$screen" \
    --arg mic "$mic" \
    --arg system "$system" \
    --argjson clips "$clips_json" \
    '{active:$active,duration:$duration,quality:$quality,screen:$screen,mic:$mic,system:$system,clips:$clips}'
}

# ---------------------------------------------------------------- dispatch
# Persist prefs without touching the daemon. Field order:
#   config <duration> <quality> [screen] [mic] [system]
# screen/mic/system may be empty strings to mean "focused monitor" / "off".
cmd_config() {
  load_prefs
  local d="${1:-}" q="${2:-}"
  local screen="${3:-}" mic="${4:-}" system="${5:-}"

  [[ -n "$d" ]] || d=$(jq -r '.duration' <<<"$payload")
  [[ -n "$q" ]] || q=$(jq -r '.quality' <<<"$payload")
  # Numeric sentinel keeps empty strings distinct from "unset" when omitted.
  case "$d" in 30|60|120) ;; *) d=60 ;; esac
  case "$q" in low|balanced|high) ;; *) q=balanced ;; esac

  jq -cn \
    --arg d "$d" \
    --arg q "$q" \
    --arg screen "$screen" \
    --arg mic "$mic" \
    --arg system "$system" \
    '{duration:($d|tonumber? // 60),quality:$q,screen:$screen,mic:$mic,system:$system}' \
    >"$CONFFILE"
  echo "{\"ok\":true,\"duration\":$d,\"quality\":\"$q\",\"screen\":\"$screen\",\"mic\":\"$mic\",\"system\":\"$system\"}"
}

case "${1:-}" in
  start)  shift; cmd_start "${1:-60}" "${2:-balanced}" ;;
  stop)   cmd_stop ;;
  clip)   shift; cmd_clip "${1:-}" ;;
  delete) shift; cmd_delete "${1:-}" ;;
  toggle) shift
    if [[ -n "$(gsr_pid)" ]]; then cmd_stop; else cmd_start "${1:-60}" "${2:-balanced}"; fi ;;
  status) cmd_status ;;
  config) shift; cmd_config "${1:-}" "${2:-}" "${3:-}" "${4:-}" "${5:-}" ;;
  devices) cmd_devices ;;
  clips)  list_clips | while IFS=$'\t' read -r path ts; do
            printf '%s\n' "$path"
          done ;;
  --clip) cmd_clip "${2:-}" ;;
  --start) cmd_start "${2:-60}" "${3:-balanced}" ;;
  --stop)  cmd_stop ;;
  --toggle) if [[ -n "$(gsr_pid)" ]]; then cmd_stop; else cmd_start "${2:-60}" "${3:-balanced}"; fi ;;
  *)      echo "usage: omaclippr {start|stop|clip|toggle|status|clips|--clip|--start|--stop|--toggle}" >&2; exit 1 ;;
esac
